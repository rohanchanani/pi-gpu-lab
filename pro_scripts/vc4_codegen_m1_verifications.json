{
  "schema_version": 1,
  "milestone": "vc4-codegen-m1",
  "title": "Typed deterministic verification specs for VC4 Codegen Milestone 1",
  "defaults": {
    "build_dir": "compiler/build",
    "state_root": ".vc4_auto/codegen_m1/verifier",
    "path_prefix": [
      "compiler/build/bin"
    ],
    "timeout_sec": 7200
  },
  "notes": [
    "Each slice has an expected_end_state and a list of typed verifications consumed by pro_scripts/vc4_codegen_m1_verifier.py.",
    "The specs intentionally verify source products by exact paths so missing tests or missing fixture inputs fail deterministically before semantic gates are mistaken for success.",
    "Hardware verifications are marked requires_hardware and can be skipped only with the verifier's explicit --no-hardware option."
  ],
  "slices": {
    "m1-00-preflight": {
      "title": "Preflight repo and toolchain checks",
      "expected_end_state": "The repo has the worklist/context/prompt inputs, the ChatGPT transport driver, a built compiler tree, and the minimal_thrend hardware fixture before any compiler-codegen patch is requested.",
      "verifications": [
        {
          "id": "existing-workflow-files",
          "mechanism": "source_products",
          "description": "Existing workflow files required for autorun/preflight are present",
          "files": [
            "pro_scripts/vc4_codegen_m1_worklist.json",
            "pro_scripts/vc4_codegen_m1_context_profiles.json",
            "pro_scripts/gpt_web_driver.js",
            "pro_scripts/prompts/vc4_codegen_m1/constitution.md",
            "pro_scripts/prompts/vc4_codegen_m1/output_contract.md",
            "pro_scripts/prompts/vc4_codegen_m1/slice_contract.md",
            "compiler/test/CodeGen/VC4/Hardware/Run/minimal_thrend/input.mlir"
          ]
        },
        {
          "id": "toolchain-tools",
          "mechanism": "tool_available",
          "description": "Core local tools resolve",
          "tools": [
            "ninja"
          ],
          "any_tools": [
            "lit",
            "llvm-lit"
          ],
          "route_hint": "codex_mechanical"
        },
        {
          "id": "build-vc4-opt",
          "mechanism": "build",
          "description": "Build vc4-opt target",
          "target": "vc4-opt",
          "route_hint": "codex_mechanical"
        },
        {
          "id": "build-check-vc4",
          "mechanism": "build",
          "description": "Build check-vc4 target",
          "target": "check-vc4",
          "route_hint": "codex_mechanical"
        }
      ]
    },
    "m1-01-artifact-tool-skeleton": {
      "title": "Add vc4-codegen artifact tool skeleton",
      "expected_end_state": "A standalone vc4-codegen tool and Target/VC4 artifact-emitter library exist, parse MLIR, reject invalid inputs, and emit the four required placeholder artifact files for a valid scheduled kernel.",
      "verifications": [
        {
          "id": "skeleton-source-products",
          "mechanism": "source_products",
          "description": "Skeleton tool/library and local tests exist",
          "files": [
            "compiler/include/vc4/Target/VC4/VC4ArtifactEmitter.h",
            "compiler/lib/Target/VC4/VC4ArtifactEmitter.cpp",
            "compiler/lib/Target/VC4/CMakeLists.txt",
            "compiler/tools/vc4-codegen/CMakeLists.txt",
            "compiler/tools/vc4-codegen/vc4-codegen.cpp",
            "compiler/test/CodeGen/VC4/Emit/vc4-codegen-skeleton.mlir",
            "compiler/test/CodeGen/VC4/Emit/vc4-codegen-skeleton-invalid.mlir"
          ]
        },
        {
          "id": "build-vc4-codegen",
          "mechanism": "build",
          "description": "Build vc4-codegen target",
          "target": "vc4-codegen",
          "route_hint": "codex_mechanical"
        },
        {
          "id": "vc4-codegen-help",
          "mechanism": "command",
          "description": "vc4-codegen exposes help text and --emit-bundle option",
          "argv": [
            "vc4-codegen",
            "--help"
          ],
          "expect_exit_code": 0,
          "stdout_contains": [
            "emit-bundle"
          ],
          "route_hint": "codex_mechanical"
        },
        {
          "id": "lit-skeleton-tests",
          "mechanism": "lit",
          "description": "Run skeleton lit tests through CodeGen/VC4/Emit root",
          "root": "compiler/build/test/CodeGen/VC4/Emit",
          "route_hint": "codex_mechanical"
        },
        {
          "id": "generate-skeleton-bundle",
          "mechanism": "vc4_codegen_generate",
          "description": "Generate .vc4_auto/codegen_m1/verifier/candidates/skeleton",
          "input": "compiler/test/CodeGen/VC4/Emit/vc4-codegen-skeleton.mlir",
          "bundle": ".vc4_auto/codegen_m1/verifier/candidates/skeleton",
          "required_files": [
            "kernel.qasm",
            "kernel_launch.c",
            "kernel_launch.h",
            "manifest.json"
          ],
          "route_hint": "gpt_pro"
        },
        {
          "id": "check-skeleton-bundle",
          "mechanism": "artifact_bundle",
          "description": "Check artifact bundle .vc4_auto/codegen_m1/verifier/candidates/skeleton",
          "bundle": ".vc4_auto/codegen_m1/verifier/candidates/skeleton",
          "required_files": [
            "kernel.qasm",
            "kernel_launch.c",
            "kernel_launch.h",
            "manifest.json"
          ],
          "manifest_required_keys": [
            "kind",
            "kernel",
            "public_name",
            "scheduled_sink_ops"
          ]
        },
        {
          "id": "check-skeleton-qasm",
          "mechanism": "qasm_text",
          "description": "The skeleton-valid bundle emits qasm text without TODO markers; later slices may replace placeholder qasm with real qasm.",
          "path": ".vc4_auto/codegen_m1/verifier/candidates/skeleton/kernel.qasm",
          "not_contains": [
            "TODO"
          ]
        },
        {
          "id": "build-check-vc4",
          "mechanism": "build",
          "description": "Build check-vc4 target",
          "target": "check-vc4",
          "route_hint": "codex_mechanical"
        }
      ]
    },
