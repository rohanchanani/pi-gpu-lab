{
  "schema_version": 1,
  "milestone": "vc4-codegen-m2",
  "title": "Milestone 2: complete scheduled-VC4 backend/runtime program bundles",
  "locked_goal": "Finish the backend for already-scheduled vc4 QPU kernels: manifest v2 program bundles, multi-kernel code arrays, persistent program image, heap-backed CUDA-like memory API, CUDA-like launch ABI, and runtime schedulers for independent-vector and cooperative-block scheduled kernels.",
  "defaults": {
    "repo_script_dir": "pro_scripts",
    "gpt_web_driver": "pro_scripts/gpt_web_driver.js",
    "build_dir": "compiler/build",
    "state_root": ".vc4_auto/codegen_m2",
    "candidate_state_root": ".vc4_auto/codegen_m2",
    "typed_verifier_script": "pro_scripts/vc4_codegen_m1_verifier.py",
    "verification_spec": "pro_scripts/vc4_codegen_m2_verifications.json",
    "prompt_template_dir": "pro_scripts/prompts/vc4_codegen_m2",
    "auto_commit_on_pass": true,
    "hardware_gates_required_by_default": true,
    "gpt_output_files": [
      "artifact_transport.json",
      "bundle.zip",
      "apply_bundle.sh"
    ],
    "build_commands": {
      "build_vc4_opt": "ninja -C compiler/build vc4-opt",
      "check_vc4": "ninja -C compiler/build check-vc4"
    },
    "required_verifier_pipeline": [
      "--vc4-verify-emit-contract",
      "--vc4-verify-scheduled-hardware-rules",
      "--vc4-verify-scheduled-adjacent-hazards",
      "--vc4-verify-scheduled-io-spacing",
      "--vc4-verify-scheduled-peripheral-accesses"
    ],
    "forbidden_paths": [
      "compiler/test/CodeGen/VC4/catalog.json",
      "pro_scripts/gpt_web_driver.js",
      ".vc4_auto/**",
      "compiler/test/**/Output/**",
      "compiler/test/**/.lit_test_times.txt",
      "compiler/test/**/run.log"
    ],
    "path_policy": {
      "paths_are_repo_relative": true,
      "reject_absolute_paths": true,
      "reject_parent_directory_components": true,
      "reject_binary_patches": true,
      "reject_existing_reference_bundle_mutation": true,
      "reject_existing_expected_json_mutation": true,
      "reject_catalog_mutation_by_default": true
    },
    "gate_environment_contract": {
      "path_prefix": [
        "compiler/build/bin"
      ],
      "candidate_state_root_env": "VC4_CODEGEN_STATE_ROOT=.vc4_auto/codegen_m2",
      "lit_run_line_contract": "Every %token in changed RUN lines must be defined by lit config or be a lit builtin."
    },
    "gpt_output_transport": "download_bundle",
    "download_bundle_transport": {
      "schema_version": 1,
      "transport": "vc4_codegen_download_bundle_v1",
      "staged_files": [
        "artifact_transport.json",
        "bundle.zip",
        "apply_bundle.sh"
      ],
      "zip_layout": [
        "manifest.json",
        "repo/<repo-relative changed files>"
      ],
      "trusted_applier": "pro_scripts/vc4_codegen_download_bundle_apply.py",
      "legacy_patch_transport_retained": true
    },
    "test_design_contract": {
      "vc4_codegen_verifies_before_emission": true,
      "generated_lit_side_effects_forbidden": [
        "compiler/test/**/Output/**",
        "compiler/test/**/.lit_test_times.txt"
      ],
      "single_kernel_is_program_bundle_with_one_kernel": true,
      "public_launch_abi_is_cuda_like_no_implicit_host_copies": true
    }
  },
