        {
          "id": "m2-orchestration-source-products",
          "mechanism": "source_products",
          "description": "Source products exist",
          "files": [
            "pro_scripts/vc4_codegen_m2_worklist.json",
            "pro_scripts/vc4_codegen_m2_verifications.json",
            "pro_scripts/vc4_codegen_m2_context_profiles.json",
            "pro_scripts/vc4_codegen_m1_verifier.py",
            "pro_scripts/vc4_codegen_m2_verifier.py",
            "pro_scripts/prompts/vc4_codegen_m2/constitution.md",
            "pro_scripts/prompts/vc4_codegen_m2/output_contract.md",
            "pro_scripts/prompts/vc4_codegen_m2/slice_contract.md",
            "compiler/docs/codegen/vc4-codegen-m2-plan.md",
            "compiler/docs/codegen/vc4-artifact-manifest-v2.md",
            "compiler/docs/codegen/vc4-runtime-abi.md",
            "compiler/docs/codegen/vc4-m2-test-matrix.md",
            "compiler/test/CodeGen/VC4/Support/run_candidate_codegen_test.sh",
            "compiler/test/CodeGen/VC4/Support/vc4_m2_candidate_test_helpers.h",
            "compiler/test/CodeGen/VC4/Support/check_m2_manifest.py",
            "compiler/test/CodeGen/VC4/Support/check_m2_layout.py",
            "compiler/test/CodeGen/VC4/Support/run_lit_subset.py"
          ]
        },
        {
          "id": "m2-new-mechanisms-registered",
          "mechanism": "command",
          "description": "Cumulative verifier lists M2 mechanisms",
          "argv": [
            "{python}",
            "pro_scripts/vc4_codegen_m1_verifier.py",
            "mechanisms",
            "--repo",
            "{repo}"
          ],
          "expect_exit_code": 0,
          "stdout_contains": [
            "manifest_schema",
            "program_artifact_bundle",
            "fixture_matrix",
            "launch_abi_contract",
            "resource_contract"
          ]
        },
        {
          "id": "support-script-m2-state-root",
          "mechanism": "support_script_contract",
          "description": "Candidate support script can switch from M1 to M2 state root",
          "script": "compiler/test/CodeGen/VC4/Support/run_candidate_codegen_test.sh",
          "required_patterns": [
            "VC4_CODEGEN_STATE_ROOT",
            "AUTO_ROOT_RAW",
            "candidates/\\$TEST_NAME"
          ]
        },
        {
          "id": "build-vc4-codegen",
          "mechanism": "build",
          "description": "Build vc4-codegen target",
          "target": "vc4-codegen",
          "route_hint": "codex_mechanical"
        },
        {
          "id": "lit-current-emit-suite",
          "mechanism": "command",
          "description": "Current non-M2/slice-local Emit suite remains green while M2-specific manifest, layout, heap, launch-ABI, resource, and multi-kernel tests are verified by their owning slices.",
          "argv": [
            "{python}",
            "compiler/test/CodeGen/VC4/Support/run_lit_subset.py",
            "--repo",
            "{repo}",
            "--root",
            "compiler/build/test/CodeGen/VC4/Emit",
            "--exclude-prefix",
            "emit-buffer-direction-metadata-no-wrapper",
            "--exclude-prefix",
            "emit-cuda-like-launch-abi",
            "--exclude-prefix",
            "emit-heap-layout-smoke",
            "--exclude-prefix",
            "emit-manifest-v2",
            "--exclude-prefix",
            "emit-multi-kernel",
            "--exclude-prefix",
            "emit-program-layout-json",
            "--exclude-prefix",
            "emit-resource",
            "--exclude-prefix",
            "emit-launch-abi-header",
            "--exclude-prefix",
            "emit-launcher-uniform-packing",
            "--exclude-prefix",
            "emit-saxpy-full-qasm-artifact-regression"
          ],
          "expect_exit_code": 0,
          "route_hint": "codex_mechanical"
        },
        {
          "id": "audit-m2-spec",
          "mechanism": "command",
          "description": "M2 spec audits against M2 worklist",
          "argv": [
            "{python}",
            "pro_scripts/vc4_codegen_m1_verifier.py",
            "audit-contract",
            "--repo",
            "{repo}",
            "--spec",
            "pro_scripts/vc4_codegen_m2_verifications.json",
            "--worklist",
            "pro_scripts/vc4_codegen_m2_worklist.json"
          ],
          "expect_exit_code": 0
        }
      ]
    },
