  "slices": {
    "m2-00-scaffold": {
      "title": "M2 verifier/worklist scaffold",
      "expected_end_state": "M2 orchestration files, cumulative verifier mechanisms, prompt contracts, and support-script state-root plumbing exist; existing M1 emit tests and saxpy_full hardware remain runnable.",
