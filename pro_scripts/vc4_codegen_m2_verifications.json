{
  "schema_version": 1,
  "milestone": "vc4-codegen-m2",
  "title": "Typed deterministic verification specs for VC4 Codegen Milestone 2",
  "defaults": {
    "build_dir": "compiler/build",
    "state_root": ".vc4_auto/codegen_m2/verifier",
    "candidate_state_root": ".vc4_auto/codegen_m2",
    "path_prefix": [
      "compiler/build/bin"
    ],
    "timeout_sec": 7200,
    "hardware_timeout_sec": 120,
    "fixture_matrices": {
      "smoke_runtime": [
        "minimal_thrend",
        "memory_output",
        "read_nop_write",
        "saxpy_full",
        "multi_kernel_chain"
      ],
      "independent_vector": [
        "saxpy_16",
        "saxpy_basic",
        "saxpy_full",
        "global_store_coalesced_multi",
        "gemv_naive_tail"
      ],
      "memory_sfu": [
        "saxpy_tmu",
        "saxpy_tmu_overlap",
        "tmu_read_nop_write",
        "tmu_strided_load",
        "sfu_recip",
        "vpm_setup_clobber",
        "vpm_slice_visibility"
      ],
      "cooperative_shared_reduction": [
        "qpu_barrier_syncthreads",
        "vpm_slice_visibility",
        "warp_reduce_sum",
        "warp_prefix_sum",
        "block_reduce_sum",
        "shared_transpose_16x16"
      ],
      "m2_required": [
        "block_reduce_sum",
        "gemv_naive_tail",
        "global_store_coalesced_multi",
        "memory_output",
        "minimal_thrend",
        "multi_kernel_chain",
        "qpu_barrier_syncthreads",
        "read_nop_write",
        "saxpy_16",
        "saxpy_basic",
        "saxpy_full",
        "saxpy_tmu",
        "saxpy_tmu_overlap",
        "sfu_recip",
        "shared_transpose_16x16",
        "tmu_read_nop_write",
        "tmu_strided_load",
        "vpm_setup_clobber",
        "vpm_slice_visibility",
        "warp_prefix_sum",
        "warp_reduce_sum"
      ]
    }
  },
  "notes": [
    "The verifier script is cumulative and remains pro_scripts/vc4_codegen_m1_verifier.py for backward compatibility.",
    "M2 introduces general program-bundle mechanisms; a single-kernel bundle is a kernels.length == 1 program.",
    "Hardware entries are marked requires_hardware and may be skipped only with --no-hardware.",
    "M2 slice 5 owns emit-launch-abi-header, emit-launcher-uniform-packing, and emit-saxpy-full-qasm-artifact-regression; m2-00 excludes them so the scaffold probe stays slice-local.",
    "Regex entries in generated_runtime_contract are Python regular expressions and must use single JSON escaping, e.g. \"PUT32\\\\s*\\\\(\" in JSON for regex PUT32\\s*\\(."
  ],
  "fixture_matrices": {
    "smoke_runtime": [
      "minimal_thrend",
      "memory_output",
      "read_nop_write",
      "saxpy_full",
      "multi_kernel_chain"
    ],
