      "saxpy_tmu",
      "saxpy_tmu_overlap",
      "sfu_recip",
      "shared_transpose_16x16",
      "tmu_read_nop_write",
      "tmu_strided_load",
      "vpm_setup_clobber",
      "vpm_slice_visibility",
      "warp_prefix_sum",
      "warp_reduce_sum"
    ]
