{
  "schema_version": 1,
  "milestone": "vc4-vc4tile-m5-mechanism-smoke",
  "title": "VC4Tile M5 verifier mechanism smoke spec",
  "defaults": {
    "build_dir": "compiler/build",
    "state_root": ".vc4_auto/vc4tile_m5/mechanism-smoke",
    "candidate_state_root": ".vc4_auto/vc4tile_m5",
    "path_prefix": [
      "compiler/build/bin"
    ],
    "timeout_sec": 120,
    "hardware_timeout_sec": 60,
    "fixture_matrices": {
      "m5_smoke_empty": []
    }
  },
  "slices": {
    "m5-mechanism-smoke": {
      "title": "M5 mechanism smoke",
      "verifications": [
        {
          "id": "m5-smoke-source-products",
          "mechanism": "source_products",
          "files": [
            "pro_scripts/vc4_milestone_verifier.py",
            "pro_scripts/vc4_vc4tile_m5_mechanism_smoke.json",
            "pro_scripts/m5_mechanism_smoke/surface_core_ok.mlir",
            "pro_scripts/m5_mechanism_smoke/copy_plan_core_ok.mlir",
            "pro_scripts/m5_mechanism_smoke/copy-plan.json",
            "pro_scripts/m5_mechanism_smoke/precision_policy_ok.txt",
            "pro_scripts/m5_mechanism_smoke/run_vc4tile_candidate_codegen_test_smoke.sh"
          ]
        },
        {
          "id": "m5-smoke-feature-gate",
          "mechanism": "feature_gate_contract",
          "features": [
            {
              "name": "m5_mechanism_smoke",
              "status": "implemented",
              "requires": {
                "surface_core": true,
                "copy_plan": true,
                "precision_policy": true,
                "pipeline": true,
                "hardware_matrix": {
                  "required": false,
                  "reason": "hardware matrix is optional for this no-hardware mechanism smoke"
                }
              }
            }
          ]
        },
        {
          "id": "m5-smoke-surface-core",
          "mechanism": "vc4tile_surface_core_contract",
          "feature": "m5_mechanism_smoke",
          "input": "pro_scripts/m5_mechanism_smoke/surface_core_ok.mlir",
          "pipeline": [],
          "work_dir": ".vc4_auto/vc4tile_m5/mechanism-smoke/surface-core",
          "core_output": "core.vc4tile.mlir",
          "must_contain": [
            "vc4tile.kernel"
          ],
          "forbid_surface_ops": true,
          "forbid_scf": true,
          "forbid_index": true,
          "forbid_producer_ops": true,
          "steps": [
            {
              "name": "write-core",
              "argv": [
                "bash",
                "-lc",
                "mkdir -p .vc4_auto/vc4tile_m5/mechanism-smoke/surface-core && cp pro_scripts/m5_mechanism_smoke/surface_core_ok.mlir .vc4_auto/vc4tile_m5/mechanism-smoke/surface-core/core.vc4tile.mlir"
              ],
              "expect_exit_code": 0
            }
          ],
          "inspect_files": [
            "core.vc4tile.mlir"
          ],
          "core_files": [
            "core.vc4tile.mlir"
          ],
          "must_not_contain": [
            "vc4tile.tile_load",
            "vc4tile.tile_store",
            "vc4tile.copy_tile",
            "scf.",
            "stablehlo.",
            "tt.",
            "iree.",
            "torch."
          ]
        },
        {
          "id": "m5-smoke-copy-plan",
          "mechanism": "vc4tile_copy_plan_contract",
          "feature": "m5_mechanism_smoke",
          "input": "pro_scripts/m5_mechanism_smoke/copy_plan_core_ok.mlir",
          "pipeline": [],
          "work_dir": ".vc4_auto/vc4tile_m5/mechanism-smoke/copy-plan",
          "core_output": "planned.vc4tile.mlir",
          "plan_output": "copy-plan.json",
          "must_contain": [
            "vc4tile.masked_load_global"
          ],
          "must_not_contain": [
            "vc4tile.tile_load",
            "vc4tile.tile_store",
            "vc4tile.copy_tile",
            "scf.",
            "stablehlo.",
            "tt.",
            "iree.",
            "torch."
          ],
          "expected_copies": [
            {
              "name": "load_x",
              "src": "global",
              "dst": "register",
              "method": "tmu",
              "required_core_ops": [
                "vc4tile.masked_load_global"
              ],
              "forbidden_core_ops": [
                "vc4tile.copy_tile"
              ]
            },
            {
              "name": "store_y",
              "src": "register",
              "dst": "global",
              "method": "vdw",
              "required_core_ops": [
                "vc4tile.masked_store_global"
              ]
            }
          ],
          "steps": [
            {
              "name": "write-plan",
              "argv": [
                "bash",
                "-lc",
                "mkdir -p .vc4_auto/vc4tile_m5/mechanism-smoke/copy-plan && cp pro_scripts/m5_mechanism_smoke/copy_plan_core_ok.mlir .vc4_auto/vc4tile_m5/mechanism-smoke/copy-plan/planned.vc4tile.mlir && cp pro_scripts/m5_mechanism_smoke/copy-plan.json .vc4_auto/vc4tile_m5/mechanism-smoke/copy-plan/copy-plan.json"
              ],
              "expect_exit_code": 0
            }
          ],
          "inspect_files": [
            "planned.vc4tile.mlir"
          ],
          "core_files": [
            "planned.vc4tile.mlir"
          ],
          "plan_path": "copy-plan.json",
          "plan_file": "copy-plan.json",
          "copy_plan_path": "copy-plan.json"
        },
        {
          "id": "m5-smoke-precision-policy",
          "mechanism": "precision_policy_contract",
          "feature": "m5_mechanism_smoke",
          "scan_files": [
            "pro_scripts/m5_mechanism_smoke/precision_policy_ok.txt"
          ],
          "required_markers": [
            "storage_type",
            "expressed_type",
            "accumulator_type",
            "precision_policy",
            "exact_32"
          ],
          "allowed_executable_precisions": [
            "i32",
            "u32",
            "f32",
            "vector<16xi32>",
            "vector<16xf32>"
          ],
          "forbidden_executable_regex": [
            "lower.*f16",
            "lower.*bf16",
            "lower.*fp8",
            "lower.*int8",
            "pack.*u8",
            "pack.*i8"
          ],
          "invalid_cases": [
            {
              "name": "unsupported-sub32-diagnostic",
              "argv": [
                "bash",
                "-lc",
                "printf 'error: M5 is 32-bit-only; sub-32 precision is reserved for the later precision milestone\\n' >&2; exit 7"
              ],
              "expect_exit_code": 7,
              "stderr_contains": [
                "32-bit-only",
                "sub-32",
                "precision"
              ]
            }
          ],
          "steps": [
            {
              "name": "write-policy",
              "argv": [
                "bash",
                "-lc",
                "mkdir -p .vc4_auto/vc4tile_m5/mechanism_smoke/precision && cp pro_scripts/m5_mechanism_smoke/precision_policy_ok.txt .vc4_auto/vc4tile_m5/mechanism_smoke/precision/precision-policy.txt"
              ],
              "expect_exit_code": 0
            }
          ],
          "inspect_files": [
            ".vc4_auto/vc4tile_m5/mechanism_smoke/precision/precision-policy.txt"
          ],
          "policy_files": [
            ".vc4_auto/vc4tile_m5/mechanism_smoke/precision/precision-policy.txt"
          ]
        },
        {
          "id": "m5-smoke-pipeline",
          "mechanism": "vc4tile_pipeline_contract",
          "feature": "m5_mechanism_smoke",
          "script": "pro_scripts/m5_mechanism_smoke/run_vc4tile_candidate_codegen_test_smoke.sh",
          "required_order": [
            "--canonicalize-vc4tile-surface",
            "--plan-vc4tile-copies",
            "--legalize-vc4tile-core-cfg",
            "--verify-vc4tile-core",
            "--convert-vc4tile-to-ssavc4",
            "--convert-ssavc4-to-vc4",
            "--emit-bundle"
          ],
          "required_intermediates": [
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/input.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/surface.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/planned.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/core.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/lowered.ssavc4.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/scheduled.vc4.mlir"
          ],
          "forbidden_patterns": [
            "convert-vc4tile-to-vc4"
          ],
          "steps": [
            {
              "name": "write-pipeline-intermediates",
              "argv": [
                "bash",
                "-lc",
                "mkdir -p .vc4_auto/vc4tile_m5/mechanism-smoke/pipeline\ncp pro_scripts/m5_mechanism_smoke/surface_core_ok.mlir .vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/input.vc4tile.mlir\ncp pro_scripts/m5_mechanism_smoke/surface_core_ok.mlir .vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/surface.vc4tile.mlir\ncp pro_scripts/m5_mechanism_smoke/surface_core_ok.mlir .vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/planned.vc4tile.mlir\ncp pro_scripts/m5_mechanism_smoke/surface_core_ok.mlir .vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/core.vc4tile.mlir\ncat > .vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/lowered.ssavc4.mlir <<'EOF'\nmodule {\n  ssavc4.module @vc4tile_lowered {\n    ssavc4.func @m5_pipeline_smoke() {\n      ssavc4.thread_end\n    }\n  }\n}\nEOF\ncat > .vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/scheduled.vc4.mlir <<'EOF'\nmodule {\n  vc4.module @m5_pipeline_smoke {\n    vc4.func @m5_pipeline_smoke {\n      vc4.qpu.bundle\n    }\n  }\n}\nEOF"
              ],
              "expect_exit_code": 0
            }
          ],
          "intermediate_files": [
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/input.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/surface.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/planned.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/core.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/lowered.ssavc4.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/scheduled.vc4.mlir"
          ],
          "inspect_files": [
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/input.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/surface.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/planned.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/core.vc4tile.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/lowered.ssavc4.mlir",
            ".vc4_auto/vc4tile_m5/mechanism-smoke/pipeline/scheduled.vc4.mlir"
          ],
          "required_pass_order": [
            "--canonicalize-vc4tile-surface",
            "--plan-vc4tile-copies",
            "--legalize-vc4tile-core-cfg",
            "--verify-vc4tile-core",
            "--convert-vc4tile-to-ssavc4",
            "--convert-ssavc4-to-vc4",
            "--emit-bundle"
          ]
        }
      ]
    }
  }
}
