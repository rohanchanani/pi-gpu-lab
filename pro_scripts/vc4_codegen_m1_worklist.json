{
  "schema_version": 1,
  "milestone": "vc4-codegen-m1",
  "title": "Milestone 1: final scheduled vc4 kernel to candidate bundle",
  "locked_goal": "Given a vc4.module with exactly one kernel vc4.func where domain=qpu, form=scheduled, vc4.launch_abi exists, and the body contains only vc4.qpu.bundle/ldi/sema/branch, emit a candidate bundle that builds and runs for minimal_thrend-like and simple memory-output-like tests.",
  "defaults": {
    "repo_script_dir": "pro_scripts",
    "gpt_web_driver": "pro_scripts/gpt_web_driver.js",
    "build_dir": "compiler/build",
    "state_root": ".vc4_auto/codegen_m1",
    "auto_commit_on_pass": true,
    "hardware_gates_required_by_default": true,
    "gpt_output_files": [
      "response.json",
      "changes.patch"
    ],
    "build_commands": {
      "build_vc4_opt": "ninja -C compiler/build vc4-opt",
      "check_vc4": "ninja -C compiler/build check-vc4"
    },
    "required_verifier_pipeline": [
      "--vc4-verify-emit-contract",
      "--vc4-verify-scheduled-hardware-rules",
      "--vc4-verify-scheduled-adjacent-hazards",
      "--vc4-verify-scheduled-io-spacing",
      "--vc4-verify-scheduled-peripheral-accesses"
    ],
    "forbidden_paths": [
      "compiler/test/CodeGen/VC4/Hardware/Run/*/reference/**",
      "compiler/test/CodeGen/VC4/Hardware/Run/*/expected.json",
      "compiler/test/CodeGen/VC4/catalog.json",
      "pro_scripts/gpt_web_driver.js",
      ".vc4_auto/**"
    ],
    "path_policy": {
      "paths_are_repo_relative": true,
      "reject_absolute_paths": true,
      "reject_parent_directory_components": true,
      "reject_binary_patches": true,
      "reject_reference_bundle_mutation": true,
      "reject_expected_json_mutation_by_default": true,
      "reject_catalog_mutation_by_default": true
    },
    "mechanical_budgets": {
      "mechanical_compile": 1,
      "mechanical_build": 1,
      "cmake_or_target": 1,
      "lit_config_syntax": 1,
      "lit_tool_resolution": 1,
      "tool_resolution": 1,
      "test_invocation": 1
    },
    "gate_environment_contract": {
      "path_prefix": [
        "compiler/build/bin"
      ],
      "lit_run_line_contract": "Every %token in changed RUN lines must be defined by lit config or be a lit builtin. The gate runner also prepends compiler/build/bin to PATH for bare repo-built tools."
    }
  },
