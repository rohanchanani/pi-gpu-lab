{
  "schema_version": 1,
  "milestone": "vc4-codegen-m1",
  "defaults": {
    "always_include": [
      {
        "kind": "file",
        "path": "pro_scripts/prompts/vc4_codegen_m1/constitution.md"
      },
      {
        "kind": "worklist_slice"
      },
      {
        "kind": "output_contract",
        "path": "pro_scripts/prompts/vc4_codegen_m1/output_contract.md"
      },
      {
        "kind": "slice_contract",
        "path": "pro_scripts/prompts/vc4_codegen_m1/slice_contract.md"
      }
    ],
    "failure_includes": [
      {
        "kind": "failure_packet"
      },
      {
        "kind": "git_diff_summary"
      },
      {
        "kind": "changed_files_excerpt"
      }
    ],
    "max_chars_ignored_by_no_truncation_patch": 140000
  },
