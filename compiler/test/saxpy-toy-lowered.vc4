module {
  vc4.func @saxpy_vec16_stage {
    %x_base = vc4.uniform 0 : i32
    %y_base = vc4.uniform 1 : i32
    %alpha = vc4.uniform 2 : f32

    %x_stage = vc4.dma_load_vpm %x_base : i32 -> !vc4.token
    %y_stage = vc4.dma_load_vpm %y_base : i32 -> !vc4.token

    %x_vec = vc4.vpm_read %x_stage : !vc4.token -> vector<16xf32>
    %y_vec = vc4.vpm_read %y_stage : !vc4.token -> vector<16xf32>
    %alpha_vec = vector.splat %alpha : vector<16xf32>

    %scaled = vc4.bin "mulf" %alpha_vec, %x_vec
      : vector<16xf32>, vector<16xf32> -> vector<16xf32>
    %sum = vc4.bin "addf" %scaled, %y_vec
      : vector<16xf32>, vector<16xf32> -> vector<16xf32>

    %store = vc4.dma_store_vpm %y_base, %sum
      : i32, vector<16xf32> -> !vc4.token
    return
  }
}
