# REQUIRES: vc4-has-triton-cpp-frontend

# RUN: rm -rf %t && mkdir -p %t

# RUN: python3 "%vc4_repo_root/compiler/test/TritonFrontend/Support/make_phase7c_negative_ttir.py" --base "%vc4_repo_root/examples/triton/phase6/generated/vector_add_b16.ttir.mlir" --kind f16_type --out %t/f16_type.ttir.mlir
# RUN: not %vc4_triton_opt %t/f16_type.ttir.mlir --convert-triton-to-vc4-value -o %t/f16_type.value.mlir 2>&1 | FileCheck %s --check-prefix=F16

# RUN: not %vc4_triton_opt "%vc4_repo_root/compiler/test/Conversion/TritonToVC4Value/Inputs/block-pointer-staged.ttir.mlir" --convert-triton-to-vc4-value -o %t/block_pointer.value.mlir 2>&1 | FileCheck %s --check-prefix=BLOCKPTR

# RUN: not %vc4_triton_opt "%vc4_repo_root/compiler/test/Conversion/TritonToVC4Value/Inputs/rank2-pointer-tensor-staged.ttir.mlir" --convert-triton-to-vc4-value -o %t/rank2_pointer.value.mlir 2>&1 | FileCheck %s --check-prefix=RANK2PTR

# F16: unsupported pointer argument element type
# F16: staged TTIR target-profile feature
# F16: READY_FOR_TRITON remains NO

# BLOCKPTR: block pointer or tensor pointer argument
# BLOCKPTR: staged TTIR target-profile feature
# BLOCKPTR: READY_FOR_TRITON remains NO

# RANK2PTR: rank-2 or higher TTIR tensor result
# RANK2PTR: staged TTIR target-profile feature
# RANK2PTR: READY_FOR_TRITON remains NO

