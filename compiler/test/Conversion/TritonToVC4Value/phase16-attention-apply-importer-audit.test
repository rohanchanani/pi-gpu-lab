# RUN: python3 "%vc4_repo_root/compiler/test/Conversion/TritonToVC4Value/Support/audit_phase16_attention_apply_importer.py" --repo-root "%vc4_repo_root" | FileCheck %s

# CHECK: PHASE16_ATTENTION_APPLY_IMPORTER_AUDIT=PASS
# CHECK: TTIR_ATTENTION_APPLY_V0_IMPORTER_STATIC=PASS
# CHECK: TTIR_ATTENTION_APPLY_V0_LOWERING=YES
# CHECK: TTIR_ATTENTION_APPLY_V0_TRANSPOSED_V_LAYOUT=YES
# CHECK: TTIR_ATTENTION_APPLY_V0_NATURAL_EXP_SOFTMAX=YES
# CHECK: TTIR_ATTENTION_APPLY_V0_WEIGHTED_SUM=YES
# CHECK: TTIR_NONTRANSPOSED_V_GATHER_REJECT=PASS
# CHECK: TTIR_SCALAR_GLOBAL_LOAD_REJECT=PASS
# CHECK: NO_NAME_PATH_FIXTURE_SPECIAL_CASES=YES
# CHECK: NO_RAW_TTIR_TEXT_PARSING=YES
# CHECK: NO_REGEX_OR_SUBSTRING_SEMANTIC_CLASSIFICATION=YES
# CHECK: STRUCTURAL_POINTER_REDUCTION_SOFTMAX_CLASSIFICATION=YES
# CHECK: NO_DIRECT_LOWER_HALF_OUTPUT=YES
# CHECK: READY_FOR_TRITON=NO
