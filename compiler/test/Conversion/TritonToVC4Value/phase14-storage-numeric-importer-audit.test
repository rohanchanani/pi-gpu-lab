// CHECK: TTIR_FP_TO_INT_REJECT=PASS
// CHECK: NO_FIXTURE_NAME_OR_PATH_SPECIAL_CASES=YES
// CHECK: NO_TTIR_TEXT_PARSING=YES
// CHECK: READY_FOR_TRITON=NO
