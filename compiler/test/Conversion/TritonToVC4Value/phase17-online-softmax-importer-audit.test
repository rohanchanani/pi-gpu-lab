# RUN: python3 "%vc4_repo_root/compiler/test/Conversion/TritonToVC4Value/Support/audit_phase17_online_softmax_importer.py" --repo-root "%vc4_repo_root" | FileCheck %s

# CHECK: PHASE17_ONLINE_SOFTMAX_IMPORTER_AUDIT=PASS
# CHECK: TTIR_ONLINE_SOFTMAX_IMPORTER_STATIC=PASS
# CHECK: TTIR_ONLINE_ATTENTION_APPLY_IMPORTER_STATIC=PASS
# CHECK: TTIR_ONLINE_SOFTMAX_LOOP_STATE_LOWERING=YES
# CHECK: TTIR_ONLINE_ATTENTION_PRECOMPUTED_SCORES=YES
# CHECK: TTIR_ONLINE_ATTENTION_TRANSPOSED_V_LAYOUT=YES
# CHECK: TTIR_ONLINE_ATTENTION_NATURAL_EXP_RECURRENT_SOFTMAX=YES
# CHECK: TTIR_ONLINE_ATTENTION_WEIGHTED_SUM=YES
# CHECK: TTIR_NONTRANSPOSED_V_GATHER_REJECT=PASS
# CHECK: TTIR_SCALAR_GLOBAL_LOAD_REJECT=PASS
# CHECK: TTIR_QK_SCORE_GENERATION_REJECT=PASS
# CHECK: NO_NAME_PATH_FIXTURE_SPECIAL_CASES=YES
# CHECK: NO_RAW_TTIR_TEXT_PARSING=YES
# CHECK: NO_REGEX_OR_SUBSTRING_SEMANTIC_CLASSIFICATION=YES
# CHECK: STRUCTURAL_LOOP_POINTER_REDUCTION_SOFTMAX_CLASSIFICATION=YES
# CHECK: NO_DIRECT_LOWER_HALF_OUTPUT=YES
# CHECK: READY_FOR_TRITON=NO
