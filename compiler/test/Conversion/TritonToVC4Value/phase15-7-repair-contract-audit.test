# RUN: python3 "%vc4_repo_root/compiler/test/Conversion/TritonToVC4Value/Support/audit_phase15_7_repair_contract.py" --repo-root "%vc4_repo_root" | FileCheck %s

# CHECK: PHASE15_7_REPAIR_CONTRACT_AUDIT=PASS
# CHECK: PHASE15_7_FAILURE_CLASSIFICATION=FIXTURE_AND_CONTRACT_MISMATCH
# CHECK: NO_NAME_PATH_MANIFEST_SPECIAL_CASES=YES
# CHECK: NO_RAW_TTIR_TEXT_PARSING=YES
# CHECK: NO_DIRECT_LOWER_HALF_OUTPUT=YES
# CHECK: NO_SCALAR_TT_LOAD_IN_ACCEPTED_PHASE15_SNAPSHOTS=YES
# CHECK: SCALAR_TT_LOAD_STAGED=YES
# CHECK: SCALAR_TT_LOAD_NONZERO_OTHER_STAGED=YES
# CHECK: TTIR_EXACT_DEFAULT_NO_POLICY_REJECT_RECLASSIFIED=YES
# CHECK: EXACT_DEFAULT_TTIR_NO_POLICY_RECLASSIFIED=YES
# CHECK: VALUE_EXACT_DEFAULT_MATH_REJECT=PASS
# CHECK: PRODUCT_OR_MATH_REDUCTION_LOWERING_STRUCTURAL=YES
# CHECK: NO_NAME_PATH_MANIFEST_SEMANTICS=YES
# CHECK: FRONTEND_ROBUSTNESS_AUDIT=PASS
# CHECK: READY_FOR_TRITON=NO
