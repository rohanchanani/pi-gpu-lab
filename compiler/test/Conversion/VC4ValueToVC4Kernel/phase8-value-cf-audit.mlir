// CHECK: PRODUCER_DIALECTS_IN_VC4KERNEL_POLICY=NO
// CHECK: FIXTURE_NAME_SPECIAL_CASES=NO
// CHECK: CUSTOM_SCF_TO_CF_LOWERING=NO
// CHECK: VC4VALUE_CONTROL_FLOW_OPS=NO
// CHECK: BRANCH_SEMANTICS_COMMENTS_ONLY=NO
// CHECK: READY_FOR_TRITON=NO
