// RUN: python3 %vc4_repo_root/compiler/test/Conversion/VC4ValueToVC4Kernel/Support/audit_phase8_value_cf.py --repo-root %vc4_repo_root | FileCheck %s

// CHECK: PHASE8_VALUE_CF_AUDIT=PASS
// CHECK: DIRECT_VALUE_TO_LOWER_HALF=NO
// CHECK: DIRECT_TTIR_TO_VC4KERNEL=NO
