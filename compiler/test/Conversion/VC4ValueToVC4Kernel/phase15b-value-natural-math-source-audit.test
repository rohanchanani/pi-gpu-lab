# RUN: python3 %S/Support/audit_phase15b_value_natural_math_static.py --repo-root %vc4_repo_root | FileCheck %s

# CHECK: VALUE_NATURAL_MATH_SOURCE_AUDIT=PASS
# CHECK: NATURAL_EXP_LOWERING=EXP2_X_LOG2E
# CHECK: NATURAL_LOG_LOWERING=LOG2_X_LN2
# CHECK: SQRT_LOWERING=RSQRT_TIMES_X
# CHECK: EXACT_DEFAULT_MATH_REJECTED=YES
# CHECK: NO_FIXTURE_NAME_OR_PATH_SPECIAL_CASES=YES
# CHECK: NO_HIDDEN_EXACT_MATH_CLAIMS=YES
# CHECK: READY_FOR_TRITON=NO
