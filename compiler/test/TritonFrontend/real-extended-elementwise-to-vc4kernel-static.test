# REQUIRES: vc4-has-triton-python
# UNSUPPORTED: legacy-python-semantic-lowering

# RUN: bash -c 'mkdir -p "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel"'
# RUN: "%vc4_triton_python" "%vc4_repo_root/tools/vc4-triton-import" "%vc4_repo_root/examples/triton/phase6/generated/saxpy_select_b16.ttir.mlir" --mode lower-elementwise-v1 --target cuda:80:32 -o "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel/saxpy_select_b16.vc4value.mlir"
# RUN: "%vc4_repo_root/compiler/build/bin/vc4-opt" "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel/saxpy_select_b16.vc4value.mlir" --vc4-verify-value-surface --convert-vc4-value-to-vc4kernel --verify-vc4kernel -o "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel/saxpy_select_b16.vc4kernel.mlir"
# RUN: FileCheck %s --check-prefix=SAXPY --input-file="%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel/saxpy_select_b16.vc4kernel.mlir"
# RUN: "%vc4_triton_python" "%vc4_repo_root/tools/vc4-triton-import" "%vc4_repo_root/examples/triton/phase6/generated/i32_add_select_b16.ttir.mlir" --mode lower-elementwise-v1 --target cuda:80:32 -o "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel/i32_add_select_b16.vc4value.mlir"
# RUN: "%vc4_repo_root/compiler/build/bin/vc4-opt" "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel/i32_add_select_b16.vc4value.mlir" --vc4-verify-value-surface --convert-vc4-value-to-vc4kernel --verify-vc4kernel -o "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel/i32_add_select_b16.vc4kernel.mlir"
# RUN: FileCheck %s --check-prefix=I32 --input-file="%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/extended_vc4kernel/i32_add_select_b16.vc4kernel.mlir"

# SAXPY: vc4kernel.kernel @saxpy_select_b16_kernel
# SAXPY: vc4kernel.tmu_load_fragment
# SAXPY: vc4kernel.vdw_store_fragment
# SAXPY-NOT: func.func
# SAXPY-NOT: vc4value.
# SAXPY-NOT: vector.
# SAXPY-NOT: tt.

# I32: vc4kernel.kernel @i32_add_select_b16_kernel
# I32: vc4kernel.tmu_load_fragment
# I32: vc4kernel.vdw_store_fragment
# I32-NOT: func.func
# I32-NOT: vc4value.
# I32-NOT: vector.
# I32-NOT: tt.
