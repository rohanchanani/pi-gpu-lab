# RUN: bash -c 'if [ ! -x "%vc4_repo_root/.vc4_auto/triton_phase6_venv/bin/python" ]; then echo "UNSUPPORTED: triton phase6 venv not present"; exit 0; fi'
# RUN: bash -c 'set +e; "%vc4_repo_root/.vc4_auto/triton_phase6_venv/bin/python" "%vc4_repo_root/tools/vc4-triton-import" "%vc4_repo_root/examples/triton/phase6/generated/vector_add_b16.ttir.mlir" --mode lower-elementwise-v1 --target cuda:80:32 -o "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton/lit_should_not_exist.vc4value.mlir" > "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton/lit_lowering_disabled.out" 2>&1; status=$?; test "$status" -ne 0 && grep -F "TTIR-to-value semantic lowering is not implemented in Phase 6; run Phase 7 after Phase 6 final lock." "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton/lit_lowering_disabled.out"'
