# REQUIRES: vc4-has-triton-python

# RUN: bash -c 'mkdir -p "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton" && printf "module { tt.func @broken( }\\n" > "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton/bad.ttir.mlir"'
# RUN: bash -c 'set +e; "%vc4_triton_python" "%vc4_repo_root/tools/vc4-triton-import" "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton/bad.ttir.mlir" --mode inventory --target cuda:80:32 --summary-json "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton/bad_import_inventory.json" > "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton/bad_import.out" 2>&1; status=$?; test "$status" -ne 0 && test ! -f "%vc4_repo_root/.vc4_auto/vector_triton_phase6e_importer_skeleton/bad_import_inventory.json"'
