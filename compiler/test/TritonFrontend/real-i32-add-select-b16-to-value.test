# REQUIRES: vc4-has-triton-python
# UNSUPPORTED: legacy-python-semantic-lowering

# RUN: bash -c 'mkdir -p "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/i32_value"'
# RUN: "%vc4_triton_python" "%vc4_repo_root/tools/vc4-triton-import" "%vc4_repo_root/examples/triton/phase6/generated/i32_add_select_b16.ttir.mlir" --mode lower-elementwise-v1 --target cuda:80:32 -o "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/i32_value/i32_add_select_b16.vc4value.mlir"
# RUN: "%vc4_repo_root/compiler/build/bin/vc4-opt" "%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/i32_value/i32_add_select_b16.vc4value.mlir" --vc4-verify-value-surface
# RUN: FileCheck %s --check-prefix=VALUE --input-file="%vc4_repo_root/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/i32_value/i32_add_select_b16.vc4value.mlir"

# VALUE: func.func @i32_add_select_b16_kernel
# VALUE: vc4value.kernel
# VALUE: vector.transfer_read %x
# VALUE: vector.transfer_read %y
# VALUE: vector.transfer_read %alt
# VALUE: vector.broadcast %bias : i32 to vector<16xi32>
# VALUE: arith.addi
# VALUE: arith.subi
# VALUE: arith.cmpi sgt
# VALUE: arith.select
# VALUE: vector.transfer_write
# VALUE-NOT: tt.
# VALUE-NOT: vc4kernel.
# VALUE-NOT: ssavc4.
# VALUE-NOT: vc4.qpu
