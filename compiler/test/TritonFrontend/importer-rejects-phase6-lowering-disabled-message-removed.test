# RUN: bash -c 'if [ ! -x "%vc4_repo_root/.vc4_auto/triton_phase6_venv/bin/python" ]; then echo "UNSUPPORTED: triton phase6 venv not present"; exit 0; fi'
# RUN: bash -c 'mkdir -p "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit"'
# RUN: bash -c 'set -e; "%vc4_repo_root/.vc4_auto/triton_phase6_venv/bin/python" "%vc4_repo_root/tools/vc4-triton-import" "%vc4_repo_root/examples/triton/phase6/generated/vector_add_b16.ttir.mlir" --mode lower-elementwise-v1 --target cuda:80:32 -o "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit/vector_add_success.vc4value.mlir" > "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit/vector_add_success.out" 2>&1; test -f "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit/vector_add_success.vc4value.mlir"; ! grep -F "TTIR-to-value semantic lowering is not implemented in Phase 6" "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit/vector_add_success.out"'
# RUN: bash -c 'set +e; "%vc4_repo_root/.vc4_auto/triton_phase6_venv/bin/python" "%vc4_repo_root/tools/vc4-triton-import" "%vc4_repo_root/examples/triton/phase6/generated/saxpy_select_b16.ttir.mlir" --mode lower-elementwise-v1 --target cuda:80:32 -o "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit/saxpy_should_not_lower.vc4value.mlir" > "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit/saxpy_reject.out" 2>&1; status=$?; test "$status" -ne 0 && test ! -f "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit/saxpy_should_not_lower.vc4value.mlir" && grep -F "unsupported TTIR op/form for Phase 7 elementwise V1: arith.mulf" "%vc4_repo_root/.vc4_auto/vector_triton_phase7b_vector_add_lowering/lit/saxpy_reject.out"'
