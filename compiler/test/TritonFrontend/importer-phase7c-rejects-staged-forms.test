# REQUIRES: vc4-has-triton-python
# UNSUPPORTED: legacy-python-semantic-lowering

# RUN: bash -c 'set -euo pipefail; ROOT="%vc4_repo_root"; OUT="$ROOT/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/rejects"; mkdir -p "$OUT"; BASE="$ROOT/examples/triton/phase6/generated/vector_add_b16.ttir.mlir"; PY="$ROOT/compiler/test/TritonFrontend/Support/make_phase7c_negative_ttir.py"; for pair in "make_range_end8:tt.make_range" "nonzero_other:tt.load" "load_nomask:tt.load" "store_nomask:tt.store" "axis_y:tt.get_program_id" "store_scatter:tt.addptr" "load_scatter:tt.addptr" "rank2_probe:tt.expand_dims" "f16_type:tt.func"; do kind="${pair%%:*}"; op="${pair##*:}"; in="$OUT/${kind}.ttir.mlir"; log="$OUT/${kind}.out"; python3 "$PY" --base "$BASE" --kind "$kind" --out "$in"; set +e; "%vc4_triton_python" "$ROOT/tools/vc4-triton-import" "$in" --mode lower-elementwise-v1 --target cuda:80:32 -o "$OUT/${kind}.vc4value.mlir" > "$log" 2>&1; status=$?; set -e; test "$status" -ne 0; test ! -f "$OUT/${kind}.vc4value.mlir"; grep -F "unsupported TTIR op/form for Phase 7 elementwise V1: $op" "$log"; done'
# RUN: bash -c 'set -euo pipefail; ROOT="%vc4_repo_root"; OUT="$ROOT/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/rejects"; set +e; "%vc4_triton_python" "$ROOT/tools/vc4-triton-import" "$ROOT/examples/triton/phase6/generated/future/matmul_dot.ttir.mlir" --mode lower-elementwise-v1 --target cuda:80:32 -o "$OUT/matmul.vc4value.mlir" > "$OUT/matmul.out" 2>&1; status=$?; set -e; test "$status" -ne 0; test ! -f "$OUT/matmul.vc4value.mlir"; grep -F "unsupported TTIR op/form for Phase 7 elementwise V1: tt.dot" "$OUT/matmul.out"'
# RUN: bash -c 'set -euo pipefail; ROOT="%vc4_repo_root"; OUT="$ROOT/.vc4_auto/vector_triton_phase7c_extended_elementwise/lit/rejects"; set +e; "%vc4_triton_python" "$ROOT/tools/vc4-triton-import" "$ROOT/examples/triton/phase6/generated/future/softmax_row.ttir.mlir" --mode lower-elementwise-v1 --target cuda:80:32 -o "$OUT/softmax.vc4value.mlir" > "$OUT/softmax.out" 2>&1; status=$?; set -e; test "$status" -ne 0; test ! -f "$OUT/softmax.vc4value.mlir"; grep -F "unsupported TTIR op/form for Phase 7 elementwise V1: tt.reduce" "$OUT/softmax.out"'
