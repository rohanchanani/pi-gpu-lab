# MAKE-RANGE: tt.make_range other than 0..16
# MAKE-RANGE: staged TTIR target-profile feature
# MAKE-RANGE: READY_FOR_TRITON remains NO

# AXIS: program_id axis 1/2 is staged until value grid-rank >1 lowering
# AXIS: staged TTIR target-profile feature
# AXIS: READY_FOR_TRITON remains NO

# REDUCE: tt.reduce
# REDUCE: staged by body feature, not unsupported control flow
# REDUCE: READY_FOR_TRITON remains NO

# DOT: tt.dot / contract
# DOT: staged by body feature, not unsupported control flow
# DOT: READY_FOR_TRITON remains NO

# RANK2: rank-2/shape-changing TTIR tensor form
# RANK2: staged TTIR target-profile feature
# RANK2: READY_FOR_TRITON remains NO

# LOAD-OTHER: tt.load other value other than zero
# LOAD-OTHER: staged TTIR target-profile feature
# LOAD-OTHER: READY_FOR_TRITON remains NO

# STORE-NOMASK: tt.store without canonical mask operand
# STORE-NOMASK: staged TTIR target-profile feature
# STORE-NOMASK: READY_FOR_TRITON remains NO

# STORE-SPARSE: multiple distinct pointer offset expressions
# STORE-SPARSE: staged TTIR target-profile feature
# STORE-SPARSE: READY_FOR_TRITON remains NO

# BACKEND: unregistered dialect
