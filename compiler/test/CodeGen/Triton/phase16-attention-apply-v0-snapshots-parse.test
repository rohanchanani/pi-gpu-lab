# RUN: FileCheck %s --check-prefix=NONTRANSPOSED --input-file=%t/nontransposed.mlir
# RUN: %vc4_triton_opt "%vc4_repo_root/examples/triton/phase16_attention_apply_v0/generated/ttir_attention_apply_scalar_scale_load_reject_b16.ttir.mlir" -o %t/scalar_load.mlir
# RUN: FileCheck %s --check-prefix=SCALARLOAD --input-file=%t/scalar_load.mlir
