# VALUE: func.func @ttir_gemv_row_dot_f32_b16_kernel
# VALUE-SAME: vc4value.reduction_policy = "finite_tree"
# VALUE: vector.transfer_read
# VALUE: arith.mulf
# VALUE: vector.reduction <add>
# VALUE: memref.store
# VALUE-NOT: tt.
# VALUE-NOT: vc4kernel.

# VC4KERNEL: vc4kernel.kernel @ttir_gemv_row_dot_f32_b16_kernel
# VC4KERNEL: vc4kernel.fragment_alu.mul
# VC4KERNEL: vc4kernel.fragment_reduce
# VC4KERNEL: vc4kernel.vdw_store_fragment
# VC4KERNEL-NOT: func.func
# VC4KERNEL-NOT: vector.
# VC4KERNEL-NOT: memref.
# VC4KERNEL-NOT: tt.

# SSAVC4: ssavc4.func @ttir_gemv_row_dot_f32_b16_kernel
# SSAVC4-NOT: vc4kernel.
# SSAVC4-NOT: func.func

# VC4: vc4.module
# VC4: vc4.qpu.
# VC4-NOT: ssavc4.
# VC4-NOT: vc4kernel.

# AUDIT: TTIR_STATIC_PIPELINE_AUDIT=PASS

# DOT: tt.dot / contract
# DOT: staged
# DOT: READY_FOR_TRITON remains NO

# LOOP: multi-block K accumulation is staged
