# RUN: FileCheck %s --check-prefix=VALUE --input-file=%t/i32_add_select_b16.vc4value.mlir
# RUN: vc4-opt %t/i32_add_select_b16.vc4value.mlir --vc4-verify-value-surface --convert-vc4-value-to-vc4kernel --verify-vc4kernel -o %t/i32_add_select_b16.vc4kernel.mlir
# RUN: FileCheck %s --check-prefix=VC4KERNEL --input-file=%t/i32_add_select_b16.vc4kernel.mlir
# RUN: vc4-opt %t/i32_add_select_b16.vc4kernel.mlir --verify-vc4kernel --convert-vc4kernel-to-ssavc4 -o %t/i32_add_select_b16.ssavc4.mlir
# RUN: FileCheck %s --check-prefix=SSAVC4 --input-file=%t/i32_add_select_b16.ssavc4.mlir
# RUN: vc4-opt %t/i32_add_select_b16.ssavc4.mlir --convert-ssavc4-to-vc4 --vc4-verify-emit-contract --vc4-verify-scheduled-hardware-rules --vc4-verify-scheduled-adjacent-hazards --vc4-verify-scheduled-io-spacing --vc4-verify-scheduled-peripheral-accesses -o %t/i32_add_select_b16.vc4.mlir
# RUN: FileCheck %s --check-prefix=VC4 --input-file=%t/i32_add_select_b16.vc4.mlir
# RUN: vc4-codegen %t/i32_add_select_b16.vc4.mlir --emit-bundle %t/i32_add_select_b16.bundle
