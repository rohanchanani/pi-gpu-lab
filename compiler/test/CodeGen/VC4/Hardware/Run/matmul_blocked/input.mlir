// RUN: vc4-opt %s --vc4-verify-emit-contract --vc4-verify-scheduled-hardware-rules --vc4-verify-scheduled-adjacent-hazards --vc4-verify-scheduled-io-spacing --vc4-verify-scheduled-peripheral-accesses -o /dev/null

// Final-stage scheduled VC4 input for the blocked f32 matrix multiplication
// hardware candidate. One cooperative resident block computes one 12-row x
// 16-column C tile per launch. The block stages each 12-row K tile of B into
// shared VPM, synchronizes all warps with the four-semaphore reusable barrier,
// and each warp accumulates one output row vector.
vc4.module @matmul_blocked {
