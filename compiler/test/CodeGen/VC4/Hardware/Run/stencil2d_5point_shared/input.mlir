// RUN: vc4-opt %s --vc4-verify-emit-contract --vc4-verify-scheduled-hardware-rules --vc4-verify-scheduled-adjacent-hazards --vc4-verify-scheduled-io-spacing --vc4-verify-scheduled-peripheral-accesses -o /dev/null

// Proper shared-memory VC4 five-point stencil. The cooperative block stages
// halo rows into VPM with all 12 resident warps, synchronizes the block, then
// computes the checked 1 x 14 output row from VPM reads only.

vc4.module @stencil2d_5point_shared {
vc4.func @stencil2d_5point_shared_kernel() attributes {
domain = #vc4.execution_domain<qpu>,
form = #vc4.function_form<scheduled>,
kernel,
threading = #vc4.threading_mode<single>,
"vc4.launch_abi" = {
public_name = "stencil2d_5point_shared",
tail_policy = "tail_safe",
uniform_words_per_qpu = 11 : i32,
args = [
{name = "input", kind = "buffer", direction = "in", elem_type = "f32", uniform_index = 0 : i32},
{name = "output", kind = "buffer", direction = "out", elem_type = "f32", uniform_index = 1 : i32},
{name = "width", kind = "scalar", direction = "by_value", type = "u32", uniform_index = 2 : i32},
{name = "height", kind = "scalar", direction = "by_value", type = "u32", uniform_index = 3 : i32},
{name = "tile_origin_x", kind = "scalar", direction = "by_value", type = "u32", uniform_index = 4 : i32},
{name = "tile_origin_y", kind = "scalar", direction = "by_value", type = "u32", uniform_index = 5 : i32},
{name = "center_weight", kind = "scalar", direction = "by_value", type = "f32", uniform_index = 6 : i32},
{name = "neighbor_weight", kind = "scalar", direction = "by_value", type = "f32", uniform_index = 7 : i32}
],
builtins = [
{name = "logical_warp_id", kind = #vc4.builtin_kind<logical_warp_id>, materialization = "uniform_suffix", uniform_index = 8 : i32},
{name = "warps_per_block", kind = #vc4.builtin_kind<warps_per_block>, materialization = "uniform_suffix", uniform_index = 9 : i32},
{name = "vpm_base_row", kind = #vc4.builtin_kind<vpm_base_row>, materialization = "uniform_suffix", uniform_index = 10 : i32}
]
},
"vc4.resource" = {
schedule_mode = "cooperative_block",
uses_barrier = true,
uses_shared_vpm = true,
require_full_block_residency = true,
warps_per_block_max = 12 : i32,
semaphores_per_block = 4 : i32,
shared_vpm_bytes = 4096 : i32
}
} {
// Uniform mapping: ra0 input, ra1 output, ra2 width, ra3 height,
// ra4 origin_x, ra5 origin_y, ra11 center_weight, ra12 neighbor_weight,
// ra6 logical_warp_id, ra7 warps_per_block, ra8 vpm_base_row.
