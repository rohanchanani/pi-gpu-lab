# VC4KERNEL: vc4kernel.kernel @value_copy_f32_tail_vc4value
# VC4KERNEL: public_name = "value_copy_f32_tail_vc4value"
# VC4KERNEL: vc4kernel.program_id
# VC4KERNEL: vc4kernel.lane_range
# VC4KERNEL: vc4kernel.pred.tail
# VC4KERNEL: vc4kernel.tmu_load_fragment
# VC4KERNEL-SAME: inactive_load = #vc4kernel.inactive_load<zero>
# VC4KERNEL-SAME: memory_path = #vc4kernel.memory_path<tmu_global_read>
# VC4KERNEL: vc4kernel.vdw_store_fragment
# VC4KERNEL-SAME: inactive_store = #vc4kernel.inactive_store<preserve>
# VC4KERNEL-SAME: memory_path = #vc4kernel.memory_path<vdw_global_store>
# VC4KERNEL-NOT: func.func
# VC4KERNEL-NOT: vc4value.
# VC4KERNEL-NOT: vector.
# VC4KERNEL-NOT: memref.
# VC4KERNEL-NOT: scf.

# SSAVC4-LABEL: ssavc4.func @value_copy_f32_tail_vc4value
# SSAVC4-SAME: {direction = "in", elem_type = "f32", kind = "buffer", name = "x", uniform_index = 0 : i32}
# SSAVC4-SAME: {direction = "inout", elem_type = "f32", kind = "buffer", name = "y", uniform_index = 1 : i32}
# SSAVC4-SAME: {direction = "by_value", kind = "scalar", name = "n", type = "i32", uniform_index = 2 : i32}
# SSAVC4: ssavc4.tmu.request
# SSAVC4: ssavc4.vdw.store
# SSAVC4-NOT: vc4kernel.
# SSAVC4-NOT: func.func
# SSAVC4-NOT: vc4value.
# SSAVC4-NOT: vector.
# SSAVC4-NOT: memref.

# VC4: vc4.module
# VC4: vc4.qpu.
# VC4-NOT: ssavc4.
# VC4-NOT: vc4kernel.

# BUNDLE: "public_name": "value_copy_f32_tail_vc4value"
