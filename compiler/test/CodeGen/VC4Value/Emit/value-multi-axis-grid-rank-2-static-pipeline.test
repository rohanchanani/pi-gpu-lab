// RUN: rm -rf %t && mkdir -p %t
// RUN: vc4-opt %s --vc4-verify-value-surface --convert-vc4-value-to-vc4kernel -o %t/grid2.vc4kernel.mlir
// RUN: vc4-opt %t/grid2.vc4kernel.mlir --verify-vc4kernel -o %t/grid2.reverified.vc4kernel.mlir
// RUN: FileCheck %s --check-prefix=VC4KERNEL --input-file=%t/grid2.vc4kernel.mlir
// RUN: vc4-opt %t/grid2.vc4kernel.mlir --verify-vc4kernel --convert-vc4kernel-to-ssavc4 -o %t/grid2.ssavc4.mlir
// RUN: FileCheck %s --check-prefix=SSAVC4 --input-file=%t/grid2.ssavc4.mlir
// RUN: vc4-opt %t/grid2.ssavc4.mlir --convert-ssavc4-to-vc4 --vc4-verify-emit-contract --vc4-verify-scheduled-hardware-rules --vc4-verify-scheduled-adjacent-hazards --vc4-verify-scheduled-io-spacing --vc4-verify-scheduled-peripheral-accesses -o %t/grid2.vc4.mlir
// RUN: FileCheck %s --check-prefix=VC4 --input-file=%t/grid2.vc4.mlir
// RUN: vc4-codegen %t/grid2.vc4.mlir --emit-bundle %t/grid2.bundle
// RUN: test -f %t/grid2.bundle/kernel_launch.c
// RUN: test -f %t/grid2.bundle/kernel_launch.h
// RUN: test -f %t/grid2.bundle/manifest.json
// RUN: test -f %t/grid2.bundle/kernels/value_multi_axis_grid_rank_2_static_pipeline.qasm
// RUN: FileCheck %s --check-prefix=BUNDLE --input-file=%t/grid2.bundle/manifest.json
// RUN: FileCheck %s --check-prefix=C --input-file=%t/grid2.bundle/kernel_launch.c

func.func @value_multi_axis_grid_rank_2_static_pipeline(
    %out: memref<256xi32, #vc4value.global> {vc4value.arg_name = "out", vc4value.direction = "out"},
    %n: index {vc4value.arg_name = "n"})
    attributes {vc4value.kernel, vc4value.grid_rank = 2 : i32} {
  %pid0 = vc4value.program_id {axis = 0 : i32} : index
  %pid1 = vc4value.program_id {axis = 1 : i32} : index
  %nx = vc4value.num_programs {axis = 0 : i32} : index
  %c16 = arith.constant 16 : index
  %row_base = arith.muli %pid1, %nx : index
  %block_id = arith.addi %row_base, %pid0 : index
  %idx = arith.muli %block_id, %c16 : index
  %mask = vector.create_mask %n : vector<16xi1>
  %value = arith.constant dense<3> : vector<16xi32>
  vector.transfer_write %value, %out[%idx], %mask {in_bounds = [true]} : vector<16xi32>, memref<256xi32, #vc4value.global>
  return
}

// VC4KERNEL-LABEL: vc4kernel.kernel @value_multi_axis_grid_rank_2_static_pipeline
// VC4KERNEL: vc4kernel.program_id
// VC4KERNEL-SAME: axis = 0
// VC4KERNEL: vc4kernel.program_id
// VC4KERNEL-SAME: axis = 1
// VC4KERNEL: vc4kernel.num_programs
// VC4KERNEL-SAME: axis = 0
// VC4KERNEL: vc4kernel.vdw_store_fragment
// VC4KERNEL-NOT: func.func
// VC4KERNEL-NOT: vc4value.
// VC4KERNEL-NOT: vector.
// VC4KERNEL-NOT: memref.

// SSAVC4-LABEL: ssavc4.func @value_multi_axis_grid_rank_2_static_pipeline
// SSAVC4-SAME: {kind = #vc4.builtin_kind<program_id_x>, materialization = "uniform_suffix", name = "program_id_x"
// SSAVC4-SAME: {kind = #vc4.builtin_kind<program_id_y>, materialization = "uniform_suffix", name = "program_id_y"
// SSAVC4-SAME: {kind = #vc4.builtin_kind<num_programs_x>, materialization = "uniform_suffix", name = "num_programs_x"
// SSAVC4-NOT: vc4kernel.
// SSAVC4-NOT: func.func
// SSAVC4-NOT: vc4value.
// SSAVC4-NOT: vector.
// SSAVC4-NOT: memref.

// VC4: vc4.module
// VC4: vc4.qpu.
// VC4-NOT: ssavc4.
// VC4-NOT: vc4kernel.

// BUNDLE: "public_name": "value_multi_axis_grid_rank_2_static_pipeline"
// BUNDLE: "kind": "program_id_x"
// BUNDLE: "kind": "program_id_y"
// BUNDLE: "kind": "num_programs_x"

// C-DAG: int value_multi_axis_grid_rank_2_static_pipeline_launch(struct vc4_program *program, vc4_dim3 grid, vc4_dim3 block
// C-DAG: uniformWords[{{[0-9]+}}] = requestInfo->program_id_x
// C-DAG: uniformWords[{{[0-9]+}}] = requestInfo->program_id_y
// C-DAG: uniformWords[{{[0-9]+}}] = requestInfo->num_programs_x
// C-DAG: vc4LaunchKernel(program, {{[0-9]+}}u, grid, block, totalRequests, warpsPerBlock
